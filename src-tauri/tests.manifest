<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<!--
  Embedded into integration-test executables (see build.rs).
  Requests Common Controls v6 so that TaskDialogIndirect (used by tauri's dialog
  code) resolves at load time. Without it Windows loads comctl32 v5 and the
  test exe fails with "Entry Point Not Found".
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*" />
    </dependentAssembly>
  </dependency>
</assembly>
